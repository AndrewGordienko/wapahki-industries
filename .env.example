# Copy this file to ".env" and fill in your keys.
# The app reads ".env" automatically — you never put keys in code.

# Apollo.io API key (required for finding people + unlocking emails).
# Get it at: https://app.apollo.io  ->  Settings -> Integrations -> API
APOLLO_API_KEY=

# Google Maps Platform key with the "Places API" enabled (OPTIONAL, for now).
# Used to auto-discover factories/warehouses in the GTA and grow the list to ~50.
# Leave blank until you have it — the rest of the app works without it.
GOOGLE_MAPS_API_KEY=

# YouTube Data API v3 key. Used only to discover public captioned videos.
YOUTUBE_API_KEY=

# Current Google web discovery: Gemini API with Google Search grounding.
GEMINI_API_KEY=
GOOGLE_RESEARCH_MODEL=gemini-2.5-flash

# Google Books public metadata API.
GOOGLE_BOOKS_API_KEY=

# Legacy only: Custom Search JSON API is closed to new customers and sunsets
# January 1, 2027. Fill these only if you already have an active CSE account.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Local web server port (optional). 8787 avoids clashing with a Vite site on 5173.
PORT=8787
