    "outagehub:hypotheses": "node scripts/research-outagehub-commercial-hypotheses.js",
    "outagehub:commercial-motion": "node scripts/normalize-outagehub-commercial-motion.js",
    "outagehub:first50": "node scripts/run-outagehub-first-50.js",
    "outagehub:top3x50": "node scripts/run-outagehub-top3x50.js",
    "outagehub:audit-top3x50": "node scripts/audit-outagehub-top3x50.js",
    "outagehub:all": "node scripts/run-outagehub-all-contacts.js",
    "gnk:scout": "node scripts/gnk-scout.js",
    "gnk:cost": "node scripts/estimate-gnk-cost.js",
    "gnk:touch1": "node scripts/write-gnk-touch1.js",
    "gnk:first50:first3": "node scripts/run-gnk-first-50-unified.js",
    "gnk:hypothesis-led:apply": "node scripts/apply-gnk-hypothesis-led-corrections.js",
    "gnk:hypothesis-led:migrate-first50": "node scripts/migrate-gnk-first50-account-theses.js",
