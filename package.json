    "gnk:board:sync": "node scripts/problems-to-gnk.js",
    "gnk:accounts:seed": "node scripts/seed-gnk-crm.js",
    "rebrand:gnk": "node scripts/rebrand-gnk.js",
    "problems:discover": "node scripts/discover-problems.js",
    "outagehub:discover": "node scripts/outagehub-discover.js",
    "grants:discover": "node scripts/discover-grants.js",
    "grants:crm:outagehub": "node scripts/seed-outagehub-grant-crm.js",
    "grants:crm:outagehub:people": "node scripts/seed-outagehub-grant-people.js",
    "grants:crm:outagehub:enrich": "node scripts/enrich-outagehub-grant-people.js",
