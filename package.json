{
  "name": "wapahki-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Basic outreach CRM for Wapahki Industries — discovers GTA factories/warehouses (Google) and the right line-level contacts (Apollo), with email, title, relevance score, and why-they'd-reply.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "seed": "node scripts/seed.js",
    "start": "node src/server.js",
    "reset": "node scripts/reset.js",
    "reddit:scrape": "python3 scripts/reddit-scraper.py",
    "reddit:scrape:oauth": "node scripts/reddit-scraper.js",
    "reddit:learn": "node scripts/reddit-learn.js",
    "reddit:bot": "python3 scripts/reddit-scraper.py && node scripts/reddit-learn.js",
    "research:bootstrap": "python3 scripts/research-scraper.py local",
    "youtube:scrape": "python3 scripts/research-scraper.py youtube",
    "google:scrape": "python3 scripts/research-scraper.py google",
    "books:scrape": "python3 scripts/research-scraper.py books",
    "research:scrape": "python3 scripts/research-scraper.py all",
    "research:learn": "node scripts/research-learn.js",
    "research:bot": "python3 scripts/research-scraper.py all && node scripts/research-learn.js",
    "touch2:youtube": "WAHPAKI_RESEARCH_CORPUS=data/research/touch2-corpus.json python3 scripts/research-scraper.py youtube --config config/touch2-sources.json",
    "touch2:google": "WAHPAKI_RESEARCH_CORPUS=data/research/touch2-corpus.json python3 scripts/research-scraper.py google --config config/touch2-sources.json",
    "touch2:books": "WAHPAKI_RESEARCH_CORPUS=data/research/touch2-corpus.json python3 scripts/research-scraper.py books --config config/touch2-sources.json",
    "touch2:research:scrape": "WAHPAKI_RESEARCH_CORPUS=data/research/touch2-corpus.json python3 scripts/research-scraper.py all --config config/touch2-sources.json",
    "touch2:reddit:scrape": "WAHPAKI_REDDIT_CORPUS=data/reddit/touch2-corpus.json WAHPAKI_REDDIT_SUBREDDITS=\"sales,salestechniques,Entrepreneur,freelancing,LeadGeneration,coldemail\" WAHPAKI_REDDIT_QUERIES=\"follow up email,cold email follow up,follow up after no reply,bump email,second follow up,sales follow up sequence,how many follow ups,breakup email\" python3 scripts/reddit-scraper.py",
    "touch2:learn": "node scripts/touch2-learn.js",
    "touch2:bot": "npm run touch2:research:scrape && node scripts/touch2-learn.js",
    "outreach:touch2": "node scripts/write-touch2.js",
    "outreach:touch2:audit": "node scripts/audit-touch2.js",
    "outreach:research": "node scripts/research-pass.js",
    "outreach:write": "node scripts/write-sequences.js",
    "outreach:subjects": "node scripts/personalize-subjects.js",
    "outreach:audit": "node scripts/audit-sequences.js",
    "outreach:schedule": "node scripts/rebalance-email-schedule.js",
    "wapahki:touch1": "node scripts/write-touch1.mjs wapahki",
    "wapahki:contacts5": "node scripts/build-wapahki-5x50.js",
    "wapahki:contacts5:archive": "node scripts/restore-wapahki-archive-to-five.js",
    "wapahki:sequences5": "node scripts/run-wapahki-seven-touch.js",
    "wapahki:sequences7": "node scripts/run-wapahki-seven-touch.js",
    "outagehub:seed": "node scripts/seed-outagehub-workspace.js",
    "outagehub:audit": "node scripts/audit-outagehub-workspace.js",
    "outagehub:touch1": "node scripts/write-outagehub-touch1.js",
